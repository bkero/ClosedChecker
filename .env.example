# Google Maps Closed Places Manager - Environment Configuration

# Server settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Playwright settings
PLAYWRIGHT_AUTH_DIR=./playwright_auth
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_MS=30000

# Rate limiting (milliseconds)
# Delay between Places API requests
PLACES_API_DELAY_MS=100
# Delay between removal actions
REMOVAL_ACTION_DELAY_MS=500

# Upload settings
MAX_UPLOAD_SIZE_MB=100
UPLOAD_TEMP_DIR=./uploads

# Note: Google Places API key is provided at runtime via the web interface
# GOOGLE_PLACES_API_KEY is optional and can be set here if preferred
